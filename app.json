{
  "expo": {
    "name": "CBH Online",
    "slug": "cbh-youth-online-mobile",
    "version": "4.1.2",
    "projectId": "172eec8c-8c58-453c-a375-258412496e09",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "com.fatties.youth",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "dark": "./app/assets/cbh-youth-iOS-Dark-1024x1024@1x.png",
        "light": "./app/assets/cbh-youth-iOS-Default-1024x1024@1x.png",
        "tinted": "./app/assets/cbh-youth-iOS-ClearDark-1024x1024@1x.png"
      },
      "bundleIdentifier": "com.fatties.youth",
      "buildNumber": "585",
      "appleTeamId": "62H5L8QDTS",
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép CBH Youth Online truy cập camera của bạn để chụp ảnh",
        "NSPhotoLibraryUsageDescription": "Cho phép CBH Youth Online truy cập thư viện ảnh của bạn",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSAppLinksUsageDescription": "Opening content from CBH Youth Online",
        "NSUserActivityTypes": [
          "NSUserActivityTypeBrowsingWeb"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.fatties.youth"
            ]
          }
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {}
        }
      },
      "associatedDomains": [
        "applinks:chuyenbienhoa.com",
        "applinks:www.chuyenbienhoa.com"
      ]
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.fatties.youth",
              "host": "oauth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.fatties.youth",
              "host": "post"
            },
            {
              "scheme": "com.fatties.youth",
              "host": "story"
            },
            {
              "scheme": "com.fatties.youth",
              "host": "group"
            },
            {
              "scheme": "com.fatties.youth",
              "host": "chat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./app/assets/adaptive-icon-monochrome.png"
      },
      "package": "com.fatties.youth",
      "googleServicesFile": "./google-services.json",
      "versionCode": 585,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./app/assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "172eec8c-8c58-453c-a375-258412496e09"
      }
    },
    "runtimeVersion": "4.7.0",
    "updates": {
      "url": "https://u.expo.dev/172eec8c-8c58-453c-a375-258412496e09"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/cbh-youth-iOS-Default-1024x1024@1x.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./app/assets/cbh-youth-iOS-Dark-1024x1024@1x.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép CBH Youth Online truy cập camera của bạn",
          "microphonePermission": "Cho phép CBH Youth Online truy cập microphone của bạn",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./app/assets/notification-monochrome.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép CBH Youth Online lưu ảnh vào thư viện của bạn",
          "savePhotosPermission": "Cho phép CBH Youth Online lưu ảnh vào thư viện của bạn",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-video",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          },
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ],
      "./plugins/withChatBubbles"
    ],
    "notification": {
      "icon": "./app/assets/notification-monochrome.png",
      "color": "#ffffff"
    }
  }
}
