<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <!--
      Takes FCM messages before expo-notifications' own service (its filter has
      priority -1). Incoming-call pushes are shown as a full-screen call
      notification; everything else is handed to expo-notifications unchanged.
    -->
    <service
      android:name="expo.modules.cbhcallui.CallMessagingService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <receiver
      android:name="expo.modules.cbhcallui.CallActionReceiver"
      android:exported="false" />
  </application>
</manifest>
