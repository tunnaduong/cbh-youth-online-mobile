+/**
+ A weak reference box that is unchecked-`Sendable`. Serves the same purpose as capturing the emitter
+ with `nonisolated(unsafe) weak let`, which newer Swift compilers (Xcode 26.2+) reject with
+ "sending ... risks causing data races" in the `@JavaScriptActor`-isolated closures below.
+ */
+private final class WeakEmitterBox: @unchecked Sendable {
+  private(set) weak var emitter: (any EventEmitter)?
+
+  init(_ emitter: any EventEmitter) {
+    self.emitter = emitter
+  }
+}
+
 public extension EventEmitter {
   /**
    Schedules an event with the given name to be emitted to the associated JavaScript object.
@@ -46,10 +59,10 @@ public extension EventEmitter {
