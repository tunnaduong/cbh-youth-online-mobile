     // never the module's own mutable state.
-    nonisolated(unsafe) weak let emitter = self
+    let emitterBox = WeakEmitterBox(self)
 
     runtime.schedule {
-      guard let emitter else {
+      guard let emitter = emitterBox.emitter else {
