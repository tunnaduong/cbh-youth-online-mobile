+package com.sbaiahmed1.reactnativeblur
+
+import android.app.ActivityManager
+import android.content.Context
+import android.view.ViewTreeObserver
+
+class ThrottledPreDrawListener(
+  private val original: ViewTreeObserver.OnPreDrawListener,
+  private val frameInterval: Int
+) : ViewTreeObserver.OnPreDrawListener {
+  private var frameCount = 0
+
+  override fun onPreDraw(): Boolean {
+    frameCount++
+    if (frameCount >= frameInterval) {
+      frameCount = 0
+      return original.onPreDraw()
+    }
+    return true
+  }
+}
+
+object ReactNativeBlurUtils {
+  private var cachedDeviceTier: Int? = null
+
+  // Tiers: 0 = Low-end, 1 = Mid-range, 2 = High-end
+  fun getDeviceTier(context: Context): Int {
+    cachedDeviceTier?.let { return it }
+
+    val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+    if (activityManager != null) {
+      if (activityManager.isLowRamDevice) {
+        cachedDeviceTier = 0
+        return 0
+      }
+    }
+
+    val processors = Runtime.getRuntime().availableProcessors()
+    if (processors <= 4) {
+      cachedDeviceTier = 0
+      return 0
+    }
+
+    try {
+      val memInfo = ActivityManager.MemoryInfo()
+      activityManager?.getMemoryInfo(memInfo)
+      if (memInfo.totalMem > 0) {
+        val totalMemGb = memInfo.totalMem.toDouble() / (1024 * 1024 * 1024)
+        if (totalMemGb <= 3.2) {
+          cachedDeviceTier = 0
+          return 0
+        } else if (totalMemGb <= 6.2) {
+          cachedDeviceTier = 1
+          return 1
+        }
+      }
+    } catch (e: Exception) {
+      // ignore
+    }
+
+    if (processors <= 6) {
+      cachedDeviceTier = 1
+      return 1
+    }
+
+    cachedDeviceTier = 2
+    return 2
+  }
+
+  fun isLowEndDevice(context: Context): Boolean {
+    return getDeviceTier(context) == 0
+  }
+
+  fun getFrameIntervalForDevice(context: Context): Int {
+    return when (getDeviceTier(context)) {
+      0 -> 1 // Not applicable since blur is disabled, but default to 1
+      1 -> 2 // Update every 2nd frame (30 FPS)
+      else -> 1 // Update every frame (60 FPS)
+    }
+  }
+}
